# Copy to .env and fill in. Referenced from config.yaml as ${VAR}.
#
# Sensitive values do NOT go here. They live in ./secrets/ (one file each, see scripts/init-secrets.sh):
#   secrets/anthropic_api_key, secrets/smtp_password, secrets/web_password,
#   secrets/feed_token, secrets/ticketmaster_api_key
# Outside Docker you can still export ANTHROPIC_API_KEY etc. directly, or set ANTHROPIC_API_KEY_FILE=<path>.

# Where you reach the dashboard (used in email links and calendar feed URLs)
PUBLIC_BASE_URL=http://eventscout.lan:8080

# Optional dashboard basic auth (password: secrets/web_password).
# Calendar feed token (secrets/feed_token): generate with `openssl rand -hex 16`; feeds then need ?token=...
WEB_USERNAME=

# Email digest
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# SMTP password: secrets/smtp_password
EMAIL_FROM=
# comma-separated for several recipients
EMAIL_TO=

# Optional sources / services (Ticketmaster key: secrets/ticketmaster_api_key)
SEARXNG_SECRET=change-me-please
BROWSERLESS_URL=
BROWSERLESS_TOKEN=
