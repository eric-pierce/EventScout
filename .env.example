# Copy to .env and fill in. Referenced from config.yaml as ${VAR}.

# Claude (llm.provider: claude)
ANTHROPIC_API_KEY=

# Where you reach the dashboard (used in email links and calendar feed URLs)
PUBLIC_BASE_URL=http://eventscout.lan:8080

# Protect calendar feed URLs: feeds need ?token=<this>. Generate with: openssl rand -hex 16
EVENTSCOUT_FEED_TOKEN=

# Optional dashboard basic auth
WEB_USERNAME=
WEB_PASSWORD=

# Email digest
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# comma-separated for several recipients
EMAIL_TO=

# Optional sources / services
TICKETMASTER_API_KEY=
SEARXNG_SECRET=change-me-please
BROWSERLESS_URL=
BROWSERLESS_TOKEN=
